# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# Database
DATABASE_URL=sqlite+aiosqlite:///./clinic.db

# API Backend
API_HOST=0.0.0.0
API_PORT=8000

# Voice Agent
AGENT_HOST=0.0.0.0
AGENT_PORT=7860

# Frontend
FRONTEND_PORT=3000

# STT (Faster-Whisper)
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS (Kokoro)
KOKORO_VOICE=af_bella
KOKORO_SPEED=1.0

# VAD (Silero)
VAD_STOP_SECS=0.5
VAD_START_SECS=0.2
VAD_CONFIDENCE=0.7
VAD_MIN_VOLUME=0.6

# RAG
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LangFuse (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# MLflow (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Logging
LOG_LEVEL=INFO
