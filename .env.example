# Ollama LLM (voice agent)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# Analytics LLM (post-call insights — larger model for deeper analysis)
ANALYTICS_MODEL=qwen3-next:80b-cloud

# Database
DATABASE_URL=sqlite+aiosqlite:///./clinic.db

# API Backend
API_HOST=127.0.0.1
API_PORT=8000

# Voice Agent
AGENT_HOST=127.0.0.1
AGENT_PORT=7860

# Frontend
FRONTEND_PORT=3000

# STT (Faster-Whisper — multilingual)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
# Leave WHISPER_LANGUAGE empty for auto-detect (Hindi/English)
# Set to "en" for English-only, or "hi" for Hindi-only

# TTS (Sarvam AI — Indian language specialist)
SARVAM_API_KEY=sk_34f5vlju_YJ7CZqVrJPdWW8ENdseGLVdG
SARVAM_MODEL=bulbul:v3
SARVAM_VOICE=priya
SARVAM_TEMPERATURE=0.75
SARVAM_PACE=1.05

# VAD (Silero)
VAD_STOP_SECS=0.5
VAD_START_SECS=0.2
VAD_CONFIDENCE=0.7
VAD_MIN_VOLUME=0.6

# RAG
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LangFuse (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# MLflow (optional)
MLFLOW_TRACKING_URI=http://localhost:5000

# Logging
LOG_LEVEL=INFO
